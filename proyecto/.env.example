# Copia este archivo a ".env" en la raíz del proyecto (junto a docker-compose.yml)
# antes de correr `docker compose up`. docker-compose lee este .env automáticamente.

# --- Base de datos ---
POSTGRES_DB=timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=timetracker
POSTGRES_PORT=5432

# --- Backend ---
# OBLIGATORIO: sin esto, `docker compose up` falla a propósito (ver docker-compose.yml).
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=CambiarEnProduccion123
SEED_ADMIN_NOMBRE=Administrador Inicial
# Poner en "true" SOLO la primera vez que se levanta el proyecto (ver docker-compose.yml).
RUN_SEED_ON_START=false
LOG_LEVEL=info
BACKEND_PORT=3000

# --- Frontend ---
# URL que el navegador usará para hablarle al backend. Si vas a acceder desde
# otro dispositivo en tu red (no localhost), cámbiala a la IP/dominio real del backend.
VITE_API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_PORT=5173
