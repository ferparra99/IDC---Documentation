# Servidor
PORT=3000

# Base de datos
DATABASE_URL=postgres://usuario:password@localhost:5432/timetracker

# Autenticación
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
# Vida del token de ACCESO (corto a propósito; la sesión larga la maneja el
# refresh token de 30 días, no configurable por env — ver AuthService).
JWT_EXPIRES_IN=1h

# Semilla inicial (usada solo por npm run seed)
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=CambiarEnProduccion123
SEED_ADMIN_NOMBRE=Administrador Inicial

# Logging
NODE_ENV=development
# Niveles disponibles: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
