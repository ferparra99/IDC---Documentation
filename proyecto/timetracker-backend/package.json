{
  "name": "timetracker-backend",
  "version": "0.1.0",
  "description": "API del sistema de control de jornada laboral (Fase 1: auth, configuracion, fichaje)",
  "main": "dist/interfaces/http/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/interfaces/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/interfaces/http/server.js",
    "migrate": "ts-node src/infrastructure/db/migrate.ts",
    "seed": "ts-node src/infrastructure/db/seed.ts",
    "sync:festivos": "ts-node src/infrastructure/db/syncFestivos.ts",
    "migrate:prod": "node dist/infrastructure/db/migrate.js",
    "seed:prod": "node dist/infrastructure/db/seed.js",
    "sync:festivos:prod": "node dist/infrastructure/db/syncFestivos.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.4.4",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "pino-pretty": "^11.2.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
